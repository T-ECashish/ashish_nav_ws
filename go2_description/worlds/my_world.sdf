<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <!-- Bright Day Scene with Sky -->
    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.5 0.8 0.9 1.0</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South and East Outer Walls (Solid) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 2.5</size></box></geometry>
          <material>
            <ambient>0.71 0.71 0.71 1</ambient>
            <diffuse>0.71 0.71 0.71 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North Wall with a Window -->
    <model name="wall_north_window">
      <static>true</static>
      <link name="left_wall">
        <pose>-3.5 5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>3 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="right_wall">
        <pose>3.5 5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>3 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.73 0.73 0.73 1</ambient>
            <diffuse>0.73 0.73 0.73 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="bottom_wall">
        <pose>0 5 0.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>4 0.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.74 0.74 0.74 1</ambient>
            <diffuse>0.74 0.74 0.74 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="top_wall">
        <pose>0 5 2.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>4 0.2 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4 0.2 0.5</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Glass Window (Translucent) -->
      <link name="glass">
        <pose>0 5 1.5 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>4 0.05 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.5 1.0 0.5</ambient>
            <diffuse>0.2 0.5 1.0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall with a Doorway and an open Door -->
    <model name="wall_west_door">
      <static>true</static>
      <link name="top_wall">
        <pose>-5 0 2.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 10 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 10 0.5</size></box></geometry>
          <material>
            <ambient>0.76 0.76 0.76 1</ambient>
            <diffuse>0.76 0.76 0.76 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="left_wall">
        <pose>-5 -3.0 1.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 4.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 4.0 2.0</size></box></geometry>
          <material>
            <ambient>0.77 0.77 0.77 1</ambient>
            <diffuse>0.77 0.77 0.77 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="right_wall">
        <pose>-5 3.0 1.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 4.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 4.0 2.0</size></box></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- A slightly open door -->
      <link name="door">
        <pose>-4.5 -1.0 1.0 0 0 0.785</pose>
        <collision name="col"><geometry><box><size>1.4 0.1 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.4 0.1 2.0</size></box></geometry>
          <material>
            <ambient>0.5 0.25 0.0 1</ambient>
            <diffuse>0.5 0.25 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dining Table -->
    <model name="table">
      <static>true</static>
      <link name="table_top">
        <pose>2 2 0.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.5 1.0 0.05</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 1.0 0.05</size></box></geometry>
          <material>
            <ambient>0.4 0.2 0.0 1</ambient>
            <diffuse>0.4 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg1">
        <pose>1.3 1.6 0.375 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></visual>
      </link>
      <link name="leg2">
        <pose>2.7 1.6 0.375 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></visual>
      </link>
      <link name="leg3">
        <pose>1.3 2.4 0.375 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></visual>
      </link>
      <link name="leg4">
        <pose>2.7 2.4 0.375 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.75</length></cylinder></geometry></visual>
      </link>
    </model>

    <!-- Chair -->
    <model name="chair">
      <static>true</static>
      <link name="seat">
        <pose>2 1.2 0.45 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.5 0.5 0.05</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="backrest">
        <pose>2 1.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.5 0.05 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.05 0.5</size></box></geometry></visual>
      </link>
      <link name="leg1">
        <pose>1.8 1.0 0.225 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></visual>
      </link>
      <link name="leg2">
        <pose>2.2 1.0 0.225 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></visual>
      </link>
      <link name="leg3">
        <pose>1.8 1.4 0.225 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></visual>
      </link>
      <link name="leg4">
        <pose>2.2 1.4 0.225 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
