<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Go2 standing pose (hip, thigh, calf) -->
    <xacro:property name="stand_hip" value="0.0"/>
    <xacro:property name="stand_thigh" value="0.8"/>
    <xacro:property name="stand_calf" value="-1.5"/>

    <xacro:macro name="leg_transmission" params="name">

        <ros2_control name="${name}_hardware" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="${name}_hip_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_hip}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="${name}_thigh_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_thigh}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="${name}_calf_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${stand_calf}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

    </xacro:macro>

</robot>
